<Window x:Class="AiController.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PanelWindowStyle}"
        Title="AI Controller Settings"
        Width="480" Height="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Border Style="{StaticResource PanelBorderStyle}">
        <StackPanel>
            <TextBlock Text="AI Controller Settings" Foreground="{StaticResource AccentBrush}"
                       FontWeight="Bold" FontSize="16" Margin="0,0,0,16" />

            <TextBlock Text="Groq API key (for voice dictation)" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="ApiKeyBox" Style="{StaticResource AccentTextBoxStyle}" Margin="0,0,0,16" />

            <CheckBox x:Name="AutostartCheckBox" Content="Start AI Controller when Windows starts"
                      Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

            <TextBlock Text="Emoji skin tone" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
            <ComboBox x:Name="SkinToneBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16" />

            <TextBlock Text="Button mappings" Foreground="{StaticResource AccentBrush}"
                       FontWeight="Bold" Margin="0,0,0,8" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                <ContentControl x:Name="MappingsList" />
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save" Click="Save_Click" Style="{StaticResource KeyButtonStyle}" MinWidth="80" />
                <Button Content="Close" Click="Close_Click" Style="{StaticResource KeyButtonStyle}" MinWidth="80" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
