<Window x:Class="AiController.Windows.ConsentGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PanelWindowStyle}"
        Title="AI Controller — Voice Privacy"
        Width="520" Height="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ShowActivated="True">
    <Border Style="{StaticResource PanelBorderStyle}">
        <StackPanel>
            <TextBlock Text="Before you use voice dictation" Foreground="{StaticResource AccentBrush}"
                       FontWeight="Bold" FontSize="16" Margin="0,0,0,16" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16">
                Pressing the voice-dictation button records audio from your microphone and
                sends it to Groq (api.groq.com), a third-party speech-to-text provider, for
                transcription. Audio is sent only while you are actively dictating — never in
                the background — and this app does not store the recording after the
                transcript comes back.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20">
                You can withdraw this consent at any time from Settings. See PRIVACY.md for
                the full policy. Declining exits the app without recording anything.
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeclineButton" Content="Decline &amp; Exit" Click="Decline_Click"
                        Style="{StaticResource KeyButtonStyle}" MinWidth="130" />
                <Button x:Name="AcceptButton" Content="I Agree" Click="Accept_Click"
                        Style="{StaticResource KeyButtonStyle}" MinWidth="100" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
